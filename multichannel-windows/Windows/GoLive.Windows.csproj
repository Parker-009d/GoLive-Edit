<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GoLivEdit</AssemblyName>
    <RootNamespace>GoLivEdit</RootNamespace>
    <ApplicationIcon>Resources\GoLive.ico</ApplicationIcon>
    <Version>0.3.92</Version>
    <AssemblyVersion>0.3.92.0</AssemblyVersion>
    <FileVersion>0.3.92.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\golive-edit-mixer.html" LogicalName="GoLivEdit.Resources.golive-edit-mixer.html" />
    <EmbeddedResource Include="Resources\phone-remote.html" LogicalName="GoLivEdit.Resources.phone-remote.html" />
    <EmbeddedResource Include="Resources\GoLive.ico" LogicalName="GoLivEdit.Resources.GoLive.ico" />
    <EmbeddedResource Include="Resources\GoLiveFX.dll" LogicalName="GoLivEdit.Resources.GoLiveFX.dll" />
  </ItemGroup>
</Project>

